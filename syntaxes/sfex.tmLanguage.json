{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "SFX",
  "scopeName": "source.sfex",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#keywords" },
    { "include": "#builtins" },
    { "include": "#stdlib" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.sfex",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.triple.sfex",
          "begin": "\"\"\"",
          "end": "\"\"\"",
          "patterns": [
            {
              "name": "constant.character.escape.sfex",
              "match": "\\\\(n|t|r|\\\\|\")"
            },
            {
              "name": "constant.other.placeholder.sfex",
              "match": "\\{[a-zA-Z_][a-zA-Z0-9_]*\\}"
            }
          ]
        },
        {
          "name": "string.quoted.double.sfex",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.sfex",
              "match": "\\\\(n|t|r|\\\\|\")"
            },
            {
              "name": "constant.other.placeholder.sfex",
              "match": "\\{[a-zA-Z_][a-zA-Z0-9_]*\\}"
            }
          ]
        },
        {
          "name": "string.quoted.single.sfex",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.sfex",
              "match": "\\\\(n|t|r|\\\\|')"
            }
          ]
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.flow.sfex",
          "match": "\\b(If|Else|ElseIf|When|Otherwise|Repeat|While|For|Each|In|Times|Break|Continue|Return)\\b"
        },
        {
          "name": "keyword.control.exception.sfex",
          "match": "\\b(Try|Catch|Always)\\b"
        },
        {
          "name": "keyword.control.context.sfex",
          "match": "\\b(Switch)\\s+(on|off)\\b"
        },
        {
          "name": "keyword.other.sfex",
          "match": "\\b(Story|Concept|Situation|Adjustment|Adjust)\\b"
        },
        {
          "name": "keyword.other.method.sfex",
          "match": "\\b(To|With|And)\\b"
        },
        {
          "name": "keyword.other.special.sfex",
          "match": "\\b(Use|Create|Called|Set|Print|Do|Background|Proceed|changes)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.sfex",
          "match": "\\b(Number|FastNumber|String|Boolean)\\b"
        },
        {
          "name": "support.type.collection.sfex",
          "match": "\\b(List|Map|Vector)\\b"
        },
        {
          "name": "support.type.advanced.sfex",
          "match": "\\b(Option|WeakRef|WeakList|WeakMap|TaskHandle|Error)\\b"
        },
        {
          "name": "entity.name.type.class.sfex",
          "match": "\\b(Concept|Situation):\\s+([A-Z][a-zA-Z0-9_]*)",
          "captures": {
            "2": {
              "name": "entity.name.type.sfex"
            }
          }
        }
      ]
    },
    "stdlib": {
      "patterns": [
        {
          "name": "support.class.stdlib.sfex",
          "match": "\\b(Data|File|HTTP|WebSocket|TCP|UDP|Env|System|Time|Math|LLM|JSON|XML|HTML|CSV|TOML|Channel|Task|Error|Stream)\\b(?=\\.)"
        },
        {
          "name": "support.function.stdlib.sfex",
          "match": "\\b(Data|File|HTTP|WebSocket|TCP|UDP|Env|System|Time|Math|LLM|JSON|XML|HTML|CSV|TOML|Channel|Task|Error|Stream)\\.([A-Z][a-zA-Z0-9_]*)\\b",
          "captures": {
            "1": {
              "name": "support.class.stdlib.sfex"
            },
            "2": {
              "name": "entity.name.function.sfex"
            }
          }
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.sfex",
          "match": "\\b(Print|Set|Create|Switch|Use|WeakRef|FastNumber|Some|None)\\b"
        },
        {
          "name": "variable.language.this.sfex",
          "match": "\\bThis\\b"
        },
        {
          "name": "variable.other.property.sfex",
          "match": "\\bThis\\.([a-zA-Z_][a-zA-Z0-9_]*)\\b",
          "captures": {
            "1": {
              "name": "variable.other.member.sfex"
            }
          }
        },
        {
          "name": "support.variable.property.sfex",
          "match": "\\.(Length|Size|IsValid|IsSome|IsNone)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.sfex",
          "match": "\\b(True|False)\\b"
        },
        {
          "name": "constant.language.option.sfex",
          "match": "\\b(Some|None)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.sfex",
          "match": "\\b\\d+\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.integer.sfex",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.sfex",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.control.logical.sfex",
          "match": "\\b(and|or|not)\\b"
        },
        {
          "name": "keyword.operator.arithmetic.sfex",
          "match": "(\\+|\\-|\\*|\\/|%)"
        },
        {
          "name": "keyword.control.assignment.sfex",
          "match": "\\b(is|to)\\b"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "entity.name.function.method.sfex",
          "match": "\\b([A-Z][a-zA-Z0-9_]*)\\.([A-Z][a-zA-Z0-9_]*)\\b",
          "captures": {
            "1": {
              "name": "variable.other.object.sfex"
            },
            "2": {
              "name": "entity.name.function.sfex"
            }
          }
        },
        {
          "name": "variable.other.property.sfex",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\.([a-zA-Z_][a-zA-Z0-9_]*)\\b",
          "captures": {
            "1": {
              "name": "variable.other.object.sfex"
            },
            "2": {
              "name": "variable.other.member.sfex"
            }
          }
        },
        {
          "name": "entity.name.type.class.sfex",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        },
        {
          "name": "variable.other.sfex",
          "match": "\\b[a-z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}
